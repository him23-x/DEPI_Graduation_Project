@model IReadOnlyList<DiscoverEgypt.Application.Responses.Disputes.AdminDisputeQueueItemResponse>
@using DiscoverEgypt.Presentation.Formatting
@{
    ViewData["Title"] = "Dispute review queue";
}

<link rel="stylesheet" href="~/css/admin-disputes.css" asp-append-version="true" />

<main class="admin-disputes-page">
    @if (TempData["AdminDisputeSuccess"] is string successMessage)
    {
        <div class="admin-dispute-alert admin-dispute-alert-success" role="status">@successMessage</div>
    }
    @if (TempData["AdminDisputeError"] is string errorMessage)
    {
        <div class="admin-dispute-alert admin-dispute-alert-error" role="alert">@errorMessage</div>
    }
    <header class="admin-disputes-heading">
        <span>ADMIN WORKSPACE · DISPUTES</span>
        <h1>Dispute review queue</h1>
        <p>Review open complaints and record a resolution that follows the booking and payment rules.</p>
    </header>

    <section class="admin-dispute-queue" aria-label="Open disputes awaiting Admin review">
        @if (Model.Count == 0)
        {
            <div class="admin-dispute-empty">
                <span aria-hidden="true">✓</span>
                <h2>No disputes to review</h2>
                <p>There are no open or under-review disputes.</p>
            </div>
        }
        else
        {
            <div class="admin-dispute-table-wrap">
                <table class="admin-dispute-table">
                    <thead>
                        <tr><th>Booking</th><th>Tourist</th><th>Provider</th><th>Booking status</th><th>Dispute status</th><th>Opened</th><th><span class="visually-hidden">Review</span></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var dispute in Model)
                        {
                            <tr>
                                <td><strong>@dispute.ServiceTitle</strong><small>@dispute.BookingType booking #@dispute.BookingId</small></td>
                                <td>@dispute.TouristName</td>
                                <td>@dispute.ProviderName</td>
                                <td>@dispute.BookingStatus</td>
                                <td><span class="admin-dispute-status">@dispute.DisputeStatus</span></td>
                                <td>@HostDateTimeFormatter.Cairo(dispute.CreatedAt, "MMM d, yyyy · h:mm tt")</td>
                                <td><a class="admin-dispute-review-link" asp-action="Details" asp-route-id="@dispute.DisputeId">Review dispute <span aria-hidden="true">→</span></a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</main>
