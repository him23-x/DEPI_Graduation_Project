@model IReadOnlyList<DiscoverEgypt.Application.Responses.AdminExperiences.AdminExperienceQueueItemResponse>
@using DiscoverEgypt.Presentation.Formatting
@{
    ViewData["Title"] = "Experience management";
}

<link rel="stylesheet" href="~/css/admin-experiences.css" asp-append-version="true" />

<main class="admin-experiences-page">
    @if (TempData["AdminExperienceReviewSuccess"] is string successMessage)
    {
        <div class="admin-review-alert admin-review-alert-success" role="status">@successMessage</div>
    }
    @if (TempData["AdminExperienceReviewError"] is string errorMessage)
    {
        <div class="admin-review-alert admin-review-alert-error" role="alert">@errorMessage</div>
    }
    <header class="admin-experiences-heading">
        <span>ADMIN WORKSPACE · EXPERIENCES</span>
        <h1>Experience management</h1>
        <p>Review submissions and manage the publishing status of experiences.</p>
    </header>

    <section class="admin-experience-queue" aria-label="Admin experience management">
        @if (Model.Count == 0)
        {
            <div class="admin-experience-empty">
                <span aria-hidden="true">✓</span>
                <h2>No experiences to manage</h2>
                <p>There are no pending, published, or unpublished experiences.</p>
            </div>
        }
        else
        {
            <div class="admin-experience-table-wrap">
                <table class="admin-experience-table">
                    <thead>
                        <tr><th>Experience</th><th>Host</th><th>Type · Area</th><th>Status</th><th>Media</th><th>Updated</th><th><span class="visually-hidden">Review</span></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var experience in Model)
                        {
                            <tr>
                                <td><strong>@experience.Title</strong><small>Submission #@experience.ExperienceId</small></td>
                                <td>@experience.HostName</td>
                                <td>@experience.ExperienceType<small>@experience.CulturalArea</small></td>
                                <td><span class="admin-experience-status admin-experience-status-@experience.Status">@experience.Status</span></td>
                                <td>@experience.ImageCount photos · @experience.VideoCount videos</td>
                                <td>@HostDateTimeFormatter.Cairo(experience.SubmittedAt, "MMM d, yyyy · h:mm tt")</td>
                                <td><a class="admin-review-link" asp-controller="Experiences" asp-action="Details" asp-route-id="@experience.ExperienceId">Inspect submission <span aria-hidden="true">→</span></a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</main>
