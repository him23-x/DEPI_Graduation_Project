@model DiscoverEgypt.Application.DTOs.HostExperiences.EvidenceFileGroupDto
@{
    var files = Model.Editor.Files.Where(item => item.Kind == Model.Kind).OrderBy(item => item.UploadedAt).ToArray();
}
<section class="form-panel evidence-panel">
    <header class="form-panel-heading">
        <span class="evidence-step-label">PRIVATE FILES · @files.Length/@Model.Maximum</span>
        <h2>@Model.Title</h2>
        <p>Required: @Model.Minimum–@Model.Maximum file@(Model.Maximum == 1 ? "" : "s").</p>
    </header>
    @if (files.Length > 0)
    {
        <ul class="evidence-file-list">
            @foreach (var file in files)
            {
                <li>
                    <span><strong>@Model.Kind</strong><small>Added @file.UploadedAt.ToLocalTime().ToString("MMM d, yyyy")</small></span>
                    <div>
                        <a class="text-action" asp-controller="Experiences" asp-action="EvidenceFile" asp-route-evidenceId="@file.Id">Download</a>
                        <form asp-controller="Experiences" asp-action="DeleteEvidence" asp-route-id="@Model.Editor.ExperienceId" method="post">
                            <input type="hidden" name="evidenceId" value="@file.Id" />
                            <button class="text-action remove-action" type="submit">Remove</button>
                        </form>
                    </div>
                </li>
            }
        </ul>
    }
    @if (files.Length < Model.Maximum)
    {
        <form class="evidence-upload-form" asp-controller="Experiences" asp-action="UploadEvidence" asp-route-id="@Model.Editor.ExperienceId" method="post" enctype="multipart/form-data">
            <input type="hidden" name="kind" value="@Model.Kind" />
            <label>Choose a PDF, JPEG or PNG<input type="file" name="file" accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png" required /></label>
            <button class="button button-secondary" type="submit">Upload file</button>
        </form>
    }
</section>
