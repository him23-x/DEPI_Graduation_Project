@model DiscoverEgypt.Application.DTOs.Guides.GuideProfileDetailsDto
@using System.Globalization
@{
    Layout = "_TouristLayout";
    ViewData["Title"] = Model.Profile.FullName;
    ViewData["TouristPage"] = "guide-details";
    var guide = Model.Profile;
}

<main class="guide-profile-page">
    <nav class="detail-breadcrumb" aria-label="Breadcrumb"><a asp-controller="Explore" asp-action="Index">Home</a><span>›</span><a asp-controller="Guides" asp-action="Index">Approved Guides</a><span>›</span><span aria-current="page">@guide.FullName</span></nav>
    <section class="guide-profile-hero"><div class="guide-profile-avatar">@if(!string.IsNullOrWhiteSpace(guide.ProfileImageKey)){<img src="@Url.Action("Image", "Guides", new { id = guide.Id })" alt="Portrait of @guide.FullName" />}else{<span>@(string.IsNullOrWhiteSpace(guide.FullName) ? "G" : guide.FullName.Trim()[0].ToString().ToUpperInvariant())</span>}</div><div class="guide-profile-intro"><div class="guide-profile-badges"><span class="approved-guide-badge"><b aria-hidden="true">✓</b> APPROVED GUIDE</span>@if(guide.ReviewCount>0){<span class="rating-summary">@guide.AverageRating.ToString("0.0",CultureInfo.InvariantCulture) · @guide.ReviewCount reviews</span>}</div><h1>@guide.FullName</h1><p>Local guide · Egypt</p><div class="guide-profile-areas">@foreach(var area in guide.CulturalAreas){<span>@area</span>}</div></div><aside class="guide-rate-card"><span>GUIDE RATE</span><strong>EGP @guide.HourlyRate.ToString("N0")</strong><small>per hour</small>@if(User.IsInRole("Tourist")){<a class="button button-gold" asp-controller="GuideBookings" asp-action="Index" asp-route-guideProfileId="@guide.Id">Book this guide</a>}else if(User.Identity?.IsAuthenticated != true){<a class="button button-gold" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Index", "GuideBookings", new { guideProfileId = guide.Id })">Log in to book</a>}<a class="button button-outline" asp-controller="Guides" asp-action="Index">Browse other guides</a></aside></section>
    <div class="guide-profile-columns"><div class="guide-profile-main"><section class="guide-about-card"><span class="detail-section-label">ABOUT YOUR GUIDE</span><h2>Local stories, shared in person</h2><p>@(string.IsNullOrWhiteSpace(guide.Bio) ? "This approved guide is ready to share knowledge of local culture and heritage." : guide.Bio)</p></section><section class="guide-credentials-card"><div><span class="detail-section-label">LANGUAGES SPOKEN</span><div class="guide-detail-tags">@if(guide.Languages.Count == 0){<span>Contact the guide for language details</span>}else{foreach(var language in guide.Languages){<span>@language</span>}}</div></div><div><span class="detail-section-label">CULTURAL AREAS</span><div class="guide-detail-tags">@if(guide.CulturalAreas.Count == 0){<span>Areas not listed</span>}else{foreach(var area in guide.CulturalAreas){<span>@area</span>}}</div></div></section><section class="guide-reviews" id="guide-reviews"><div class="reviews-heading"><div><span class="detail-section-label">TRAVELER FEEDBACK</span><h2>Reviews of @guide.FullName</h2></div><div class="review-average">@(guide.ReviewCount > 0 ? guide.AverageRating.ToString("0.0", CultureInfo.InvariantCulture) : "New")<small>@(guide.ReviewCount > 0 ? $"out of 5 · {guide.ReviewCount} reviews" : "No reviews yet")</small></div></div>@if(Model.Reviews.Count == 0){<p class="no-reviews">There are no guide reviews yet.</p>}else{@foreach(var review in Model.Reviews){<article class="public-review"><div class="review-avatar">@(string.IsNullOrWhiteSpace(review.TouristName)?"T":review.TouristName.Trim()[0].ToString().ToUpperInvariant())</div><div class="public-review-copy"><div class="review-byline"><strong>@review.TouristName</strong><span>@review.Rating / 5</span></div><time datetime="@review.CreatedAt.ToString("O")">@review.CreatedAt.ToString("MMM d, yyyy",CultureInfo.GetCultureInfo("en-US"))</time>@if(!string.IsNullOrWhiteSpace(review.Comment)){<p>@review.Comment</p>}</div></article>}}</section></div><aside class="guide-profile-aside"><div class="guide-approved-note"><span class="guide-note-mark" aria-hidden="true">✓</span><h2>Verified for your peace of mind</h2><p>This guide's latest verification request is approved and their listed license has not expired.</p></div><div class="guide-public-data-note"><span aria-hidden="true">⌑</span><p>Identity and license documents stay private and are never displayed on public profiles.</p></div><a class="button button-outline guide-back-button" asp-controller="Guides" asp-action="Index">← Back to approved guides</a></aside></div>
</main>
